    g.font = "bold 34px 'Segoe UI','Noto Sans TC',sans-serif"; g.textAlign = "center"; g.textBaseline = "middle"; g.lineWidth = 7; g.strokeStyle = "#fff"; g.strokeText(name, 128, 32); g.fillStyle = "#3c4043"; g.fillText(name, 128, 32);
