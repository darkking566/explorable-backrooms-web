patch(floorMat, "floor", { pits: true, basinCut: true }); patch(ceilMat, "ceil", { holes: true });
patch(redCeilMat, "tint"); patch(stairCeilMat, "tint");
// floor & ceiling follow player, snapped to texture period so they never swim
