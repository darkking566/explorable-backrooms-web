        for (let x = 64; x < w; x += 128) { const gr = g.createRadialGradient(x, y + 24, 0, x, y + 24, 70); gr.addColorStop(0, "rgba(255,240,150,.35)"); gr.addColorStop(1, "rgba(255,240,150,0)"); g.fillStyle = gr; g.fillRect(x - 70, y + 22, 140, 96); }
