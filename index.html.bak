const ceilHoles = [rectOf(BLOCKS.find(b => b.t === RED)), new THREE.Vector4(STX, STZ, STX + 12, STZ + 12), rectOf(AT)];   // red room, stairwell and atrium each have a ceiling of their own
function patch(mat, key, { pits, holes, basinCut } = {}) {
