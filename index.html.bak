    const a = hash(k, 1, 96) * 6.2832, r = hash(k, 2, 96) * 110; s.position.set(Math.cos(a) * r, (hash(k, 3, 96) - .5) * 170, Math.sin(a) * r); s.scale.setScalar(90 + hash(k, 4, 96) * 120); dust.add(s);
